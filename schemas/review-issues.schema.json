{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "sourceIds",
      "subjectIds",
      "kind",
      "title",
      "detail",
      "requiresHumanReview"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "sourceIds": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      },
      "subjectIds": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      },
      "kind": {
        "enum": ["typo", "conflict", "gap"]
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "detail": {
        "type": "string",
        "minLength": 1
      },
      "requiresHumanReview": {
        "type": "boolean"
      },
      "status": {
        "enum": ["open", "resolved", "partially-resolved"]
      },
      "resolution": {
        "type": ["string", "null"]
      },
      "resolvedAt": {
        "type": ["string", "null"],
        "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
      }
    }
  }
}
